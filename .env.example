# Server-only Qwen upstream configuration. Never prefix these with NEXT_PUBLIC_.
QWEN_API_BASE_URL=https://llm.667764.xyz/v1
QWEN_MODEL=qwen3.6:35b
CF_ACCESS_CLIENT_ID=replace-with-cloudflare-access-client-id
CF_ACCESS_CLIENT_SECRET=replace-with-cloudflare-access-client-secret

# Shared internal password required by the app proxy; users enter this in Settings.
QWEN_ENABLER_PASSWORD=replace-with-internal-feature-password

# Optional: extra allowed frontend origins for a separately hosted Tauri client.
QWEN_PROXY_ALLOWED_ORIGINS=http://localhost:3001,tauri://localhost,http://tauri.localhost,https://tauri.localhost

# Public, non-secret settings. The Tauri desktop builds use the VM's hosted proxy;
# hosted web builds can also leave this blank to use same-origin.
NEXT_PUBLIC_QWEN_PROXY_URL=https://refx.667764.xyz
NEXT_PUBLIC_QWEN_MODEL=qwen3.6:35b
